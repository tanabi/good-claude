#!/usr/bin/env python3
"""good-claude: a plain read-eval-print loop over the Claude Agent SDK.

The interactive Claude Code TUI owns the screen and hard-wraps every line to
the terminal width. This client never draws a UI: the model's text goes to
stdout a whole message segment at a time, not character by character, so the
terminal does all wrapping and scrolling and the output can be selected and
pasted unchanged. That makes it usable with a screen reader, and it makes
copied output paste cleanly somewhere else.

Everything that is not model text -- the banner, tool announcements, approval
prompts, errors -- goes to stderr, so `good-claude > transcript.txt` captures
only what the model said.

Input:
    Every prompt is multi-line. Enter only ever starts a new line, so nothing
    is sent by accident and pasted text arrives as a single prompt. Ctrl-D on
    an empty line sends what you have typed so far; Ctrl-D with nothing typed
    does nothing. Quitting takes an explicit `/quit` on a line of its own.
    Ctrl-C interrupts the turn in progress. One thread owns stdin for the whole
    session and decides what each typed line is for, so a tool asking for
    approval and a message being composed can never race for the same line.
    Pasted text arrives as plain keystrokes: the terminal's bracketed-paste
    mode is turned off before each read, because libedit -- which is what
    Python's readline is on macOS and on any Homebrew python3 -- mangles the
    markers into the text instead of understanding them. Nothing here needs
    them, since Enter is never send.

Tool approval:
    Every tool call is presented for approval: allow once, allow that exact
    call for the rest of the session, allow every call to that tool for the
    rest of the session, or deny with an optional reason that is passed back to
    the model. Approving a call approves that call and nothing else, so
    approving `git status` does not also approve every other Bash command; the
    blanket answer is a separate key. A call that would change a file shows the
    change as a diff first, so the question is never "may I edit this file"
    without an answer to "edit it how". A prompt owns the terminal while it
    waits, so a tool result arriving mid-prompt is held until you have
    answered rather than printed on top of the question. A tool that manages to
    ask while you are back at the message prompt says so, and one Enter gets
    you to the question with your typed text kept. Answering a pending approval
    always comes before sending a message, since the model is blocked on it.
    This is enforced with a PreToolUse hook rather than the SDK's can_use_tool
    callback, because it only fires when the CLI's permission rules already
    evaluate to "ask" -- anything covered by an allow rule in settings would
    otherwise run unannounced.

Subagents:
    Agent calls are rewritten to run in the foreground, so a delegated result
    comes back inside the turn that asked for it. Backgrounding one only pays
    off when there is a second conversation to get on with, and there is not:
    one terminal, one prompt. Set GOOD_CLAUDE_BACKGROUND_AGENTS=1 to allow it.
    Backgrounded shells are left alone; they are meant to outlive the call.

    When an agent does run in the background, the turn ends at a result with no
    agent still running rather than at the first result, because a backgrounded
    agent outlives the turn that started it and wakes the model again when it
    finishes. The prompt stays down until that has played out.

Sessions:
    The session id is appended to ~/.good-claude/session-history.txt, so a
    session is still recoverable if the terminal or the machine dies.
    Resume one with `good-claude --resume <id>`.

Environment:
    GOOD_CLAUDE_MODEL     model alias or id (default: your configured model)
    GOOD_CLAUDE_THINKING  set to 1 to show thinking text as well
    GOOD_CLAUDE_BACKGROUND_AGENTS
                          set to 1 to let the model background subagents

Known gap:
    Text pasted while a turn is running is echoed twice: once by the terminal
    driver as it arrives, since nothing is reading stdin then, and again by
    readline when the prompt comes back and it reads those bytes. The message
    itself is correct; only the screen repeats. Pasting at the prompt rather
    than mid-turn avoids it.
"""

from __future__ import annotations

import argparse
import asyncio
import difflib
import json
import os
import readline  # noqa: F401  (gives input() editing and history)
import sys
import threading
import time
from collections import deque
from typing import Any

from claude_agent_sdk import (
    TERMINAL_TASK_STATUSES,
    AssistantMessage,
    ClaudeAgentOptions,
    ClaudeSDKClient,
    HookMatcher,
    ResultMessage,
    SystemMessage,
    TaskNotificationMessage,
    TaskStartedMessage,
    TaskUpdatedMessage,
    TextBlock,
    ThinkingBlock,
    ToolResultBlock,
    UserMessage,
)

QUIT_COMMANDS = ("/quit", "/exit")
SHOW_THINKING = os.environ.get("GOOD_CLAUDE_THINKING") == "1"
# Generous: the hook is waiting on a human, not on a computation.
APPROVAL_TIMEOUT_SECONDS = 3600.0
HISTORY_PATH = os.path.expanduser("~/.good-claude/session-history.txt")
# Diff lines shown before an approval prompt. A whole-file rewrite can be
# thousands of lines, which would scroll the question off the screen; `v`
# still shows the entire input.
PREVIEW_LINES = 60
# Lines of unchanged context around each change in a preview diff.
PREVIEW_CONTEXT = 3
# Input fields that only describe a call to the reader and do not change what it
# does. The model rewords these freely, which would otherwise make a call the
# user already approved for the session look like a new one.
COSMETIC_FIELDS = ("description",)
# Task kinds a turn waits for after its own result arrives. Delegated agent work
# only: a backgrounded shell -- `tail -f`, a dev server -- is reported through
# the same lifecycle frames but may never reach a terminal status, so waiting on
# one would park the session forever instead of briefly. Agent tasks are the
# ones whose completion wakes the model for a follow-up turn, which is the thing
# worth waiting for. Mirrors the SDK's own DEFERRING_TASK_TYPES, which is
# private, so it is restated here rather than imported.
DEFERRED_TASK_TYPES = frozenset({"local_agent", "local_workflow"})
# Python's readline is GNU readline on most Linux distributions and libedit
# (editline) on macOS and on Homebrew/linuxbrew builds anywhere, including on
# Linux. The two disagree about pasting; see disable_bracketed_paste.
READLINE_IS_LIBEDIT = "libedit" in (readline.__doc__ or "")
# DEC private mode 2004 off: deliver a paste as ordinary keystrokes.
BRACKETED_PASTE_OFF = "\x1b[?2004l"
# Tools that delegate to a subagent. Named separately from the background shell
# case, which must keep its own meaning of "background". See foreground_input.
AGENT_TOOLS = ("Agent", "Task")
# Backgrounding an agent buys parallel conversations, which this client does not
# have; set GOOD_CLAUDE_BACKGROUND_AGENTS=1 to let the model background them.
FORCE_FOREGROUND = os.environ.get("GOOD_CLAUDE_BACKGROUND_AGENTS") != "1"

# Exact tool calls the user has approved for the rest of this session, keyed by
# signature(). "Always" means this call, not this tool: approving `git status`
# must not also approve `rm -rf /`, since both are Bash.
session_allowed_calls: set[str] = set()
# Whole tools the user has approved for the rest of this session. Deliberately
# a separate, more emphatic answer than approving one call.
session_allowed_tools: set[str] = set()
# Held by whoever is writing to the terminal: an approval prompt while it waits
# for an answer, or the turn loop while it prints. One tool's result arrives
# while the next tool's prompt is up, so without this they land on top of each
# other. It also serializes the prompts themselves, since parallel tool calls
# fire hooks concurrently.
screen_lock = asyncio.Lock()
# In-flight writes of subprocess stderr, held so the tasks are not collected
# before they run.
cli_stderr_tasks: set[asyncio.Task] = set()


class Approval:
    """One tool call waiting for the user's answer.

    Made on the event loop by the hook that needs the answer, answered on the
    reader thread, which resolves the future back on the loop.
    """

    def __init__(self, tool: str, data: dict[str, Any], future: asyncio.Future) -> None:
        """Record the call and the future its answer is delivered through."""
        self.tool = tool
        self.data = data
        self.future = future
        # Set when the call is being rewritten before it runs, so that an
        # approval carries the rewrite back with it. See foreground_input.
        self.updated_input: dict[str, Any] | None = None


# Exactly one thread ever calls input(): the reader started by main(). Two
# things want typed lines -- the message being composed and an approval prompt
# for a tool call -- and a tool the model started in the background asks for
# approval whenever it happens to run, which is usually while the message
# prompt is already blocked in input(). Two threads inside input() at once are
# serialized by readline's own lock, so each line goes to whichever one won the
# race: the answer to the approval disappears into the half-typed message and
# the prompt looks wedged, re-asking forever. Every read goes through the
# reader thread instead, one line at a time, and the state below tells it what
# the next line is for. A waiting approval is always served first.
input_cv = threading.Condition()
pending_approvals: deque[Approval] = deque()
# Set while the message loop is waiting for a message.
composing = False
# Set while the reader is blocked in input() for a line of a message. An
# approval that arrives then cannot be shown until that line is finished, so
# the user is told to press Enter to get to it.
composer_reading = False
reader_stopping = False
# Set when a turn produces text, so an empty turn can fall back to the result.
turn_had_text = False
# Last character written to stdout, so turns are separated by exactly one blank line.
last_char = "\n"


def log_session(session_id: str) -> None:
    """Append a session id to the history file."""
    os.makedirs(os.path.dirname(HISTORY_PATH), exist_ok=True)
    with open(HISTORY_PATH, "a", encoding="utf-8") as handle:
        handle.write(session_id + "\n")


def meta(text: str) -> None:
    """Write a non-model line to stderr."""
    sys.stderr.write(text + "\n")
    sys.stderr.flush()


def strip_controls(text: str) -> str:
    """Text with control characters turned into spaces, tabs kept.

    Applied to output that came from another program. Nothing arriving that way
    is allowed to move the cursor, set a terminal mode, or open a paste bracket.
    """
    return "".join(
        ch if ch == "\t" or (ch >= " " and ch != "\x7f") else " " for ch in text
    )


async def meta_locked(text: str) -> None:
    """Print a meta line without cutting into whoever owns the screen."""
    async with screen_lock:
        meta(text)


def cli_stderr(text: str) -> None:
    """Print one line the claude subprocess wrote to its own stderr.

    Registering this callback is what makes the SDK give the subprocess a pipe.
    Without it the SDK passes stderr through, which means the subprocess
    inherits this program's stderr -- the user's terminal -- and writes to it
    whenever it likes, including terminal control sequences, on top of a
    half-typed message that readline is in the middle of displaying. It cannot
    take screen_lock to avoid that, because it is a different process. Piping
    it here puts every write back under this program's control, and stripping
    control characters keeps another program from steering the terminal.
    """
    line = strip_controls(text).rstrip()
    if not line:
        return
    try:
        loop = asyncio.get_running_loop()
    except RuntimeError:
        meta("[claude] " + line)
        return
    # Called from the SDK's reader task, which is on the loop, so the lock has
    # to be taken in a task rather than awaited here. The set keeps a strong
    # reference; a bare create_task can be collected before it runs.
    task = loop.create_task(meta_locked("[claude] " + line))
    cli_stderr_tasks.add(task)
    task.add_done_callback(cli_stderr_tasks.discard)


def emit(text: str) -> None:
    """Write model text to stdout with no added newlines."""
    global turn_had_text, last_char
    if text:
        turn_had_text = True
        last_char = text[-1]
        sys.stdout.write(text)
        sys.stdout.flush()


def emit_block(text: str) -> None:
    """Write one finished message segment, ending it on its own line."""
    if not text:
        return
    emit(text)
    if last_char != "\n":
        emit("\n")


def disable_bracketed_paste() -> None:
    """Make the terminal deliver a paste as ordinary keystrokes.

    In bracketed-paste mode a terminal wraps pasted text in ESC[200~ and
    ESC[201~ so that a reader can tell it from typing. GNU readline understands
    those markers. libedit does not: it eats the first few bytes of each escape
    and leaves the rest in the text, so a pasted paragraph arrives with `0~`
    welded to its first line and a stray `1~` line after it, and the
    half-swallowed escape goes on to confuse the terminal itself. That is the
    paste corruption, and it is why it follows the machine rather than the
    source of the text: macOS is always libedit, and so is any Homebrew python3
    on Linux.

    Nothing here wants the markers. Enter is never send (rule 6), so a paste
    read as plain keystrokes is already safe -- which is the whole reason this
    client composes the way it does.

    The mode belongs to the terminal, not to this process, and this process
    does not have it to itself: the claude subprocess shares the terminal and
    the user's shell may have left the mode on. So it is turned off before
    every read rather than once at startup. Writing an escape sequence is the
    one exception to "no ANSI" (rule 3): it sets an input mode instead of
    drawing anything, it undoes a mode some other program turned on, and it is
    written only to a terminal, so a redirected log never sees it.
    """
    if READLINE_IS_LIBEDIT and sys.stderr.isatty():
        sys.stderr.write(BRACKETED_PASTE_OFF)
        sys.stderr.flush()


def ask(prompt: str) -> str | None:
    """Prompt on stderr and read a line. None means the input ended (Ctrl-D)."""
    disable_bracketed_paste()
    sys.stderr.write(prompt)
    sys.stderr.flush()
    try:
        return input()
    except EOFError:
        return None


def read_line(prompt: str) -> str | None:
    """Read one line of a message. None means Ctrl-D.

    The prompt is passed to input(), which writes it to stdout, so the caller
    passes one only when stdout is a terminal: a redirected transcript holds
    model text and nothing else.
    """
    disable_bracketed_paste()
    try:
        return input(prompt)
    except EOFError:
        return None


def join_lines(lines: list[str]) -> str:
    """One message from the typed lines, minus the trailing blank ones."""
    kept = list(lines)
    while kept and not kept[-1].strip():
        kept.pop()
    return "\n".join(kept)


def request_prompt() -> None:
    """Tell the reader the message loop is waiting for a message."""
    global composing
    with input_cv:
        composing = True
        input_cv.notify()


def deliver_prompt(
    loop: asyncio.AbstractEventLoop, prompts: asyncio.Queue, text: str | None
) -> None:
    """Hand a finished message, or None to quit, to the message loop."""
    global composing
    with input_cv:
        composing = False
    loop.call_soon_threadsafe(prompts.put_nowait, text)


def stop_reader() -> None:
    """Tell the reader to stop once it is not mid-line."""
    global reader_stopping
    with input_cv:
        reader_stopping = True
        input_cv.notify()


def queue_approval(approval: Approval) -> bool:
    """Give a tool call to the reader thread.

    True when the reader is already blocked on a line of a message, in which
    case the question cannot be shown until that line is finished.
    """
    with input_cv:
        pending_approvals.append(approval)
        input_cv.notify()
        return composer_reading


def resolve_approval(approval: Approval, answer: dict[str, Any]) -> None:
    """Give a waiting hook its answer. Runs on the event loop."""
    if not approval.future.done():
        approval.future.set_result(answer)


def abandon_approvals() -> None:
    """Deny every unanswered call, so no tool is left waiting at exit."""
    with input_cv:
        waiting = list(pending_approvals)
        pending_approvals.clear()
    for approval in waiting:
        resolve_approval(approval, decision("deny", "good-claude is exiting."))


def next_input_work() -> Approval | str:
    """Block until there is a line to read.

    Returns the approval to ask about, "message" for a line of the message
    being composed, or "stop" when the session is over.
    """
    with input_cv:
        while True:
            if reader_stopping:
                return "stop"
            if pending_approvals:
                return pending_approvals.popleft()
            if composing:
                return "message"
            input_cv.wait()


def hold_screen(loop: asyncio.AbstractEventLoop) -> None:
    """Take the terminal lock from the reader thread.

    screen_lock belongs to the event loop and cannot be taken with `with` from
    another thread. Scheduling the acquire and waiting for it here keeps the
    loop free to service the SDK connection while the user reads the question.
    """
    asyncio.run_coroutine_threadsafe(screen_lock.acquire(), loop).result()


def release_screen(loop: asyncio.AbstractEventLoop) -> None:
    """Give the terminal lock back. Releasing is not itself thread-safe."""
    loop.call_soon_threadsafe(screen_lock.release)


def summarize(tool: str, data: dict[str, Any]) -> str:
    """One readable line describing what a tool call is about to do."""
    if tool == "Bash" and "command" in data:
        return str(data["command"])
    for key in ("file_path", "path", "notebook_path", "url", "pattern", "query"):
        if key in data:
            return str(data[key])
    return json.dumps(data)[:400]


def signature(tool: str, data: dict[str, Any]) -> str:
    """A stable key for one exact tool call, for the session allow list.

    Keyed on the whole input rather than the tool name, so approving a call
    approves that call and nothing else. Cosmetic fields are dropped: they can
    differ between two runs of what is, to the machine, the same call.
    """
    material = {k: v for k, v in data.items() if k not in COSMETIC_FIELDS}
    return "%s %s" % (tool, json.dumps(material, sort_keys=True, default=str))


def diff_lines(before: str, after: str, hunks: bool) -> list[str]:
    """Unified diff of two strings, without the ---/+++ file headers.

    `hunks` keeps the @@ markers. They are worth showing when the line numbers
    mean something, as in a whole-file rewrite, and misleading when the two
    sides are snippets pulled out of the middle of a file, as in an Edit.
    """
    lines = difflib.unified_diff(
        before.splitlines(),
        after.splitlines(),
        lineterm="",
        n=PREVIEW_CONTEXT,
    )
    out = []
    for line in lines:
        if line.startswith("---") or line.startswith("+++"):
            continue
        if line.startswith("@@"):
            if not hunks:
                continue
            if out:
                out.append("")
        out.append(line)
    return out


def read_file(path: str) -> str | None:
    """Current contents of a file, or None if it cannot be read."""
    try:
        with open(path, encoding="utf-8", errors="replace") as handle:
            return handle.read()
    except OSError:
        return None


def preview(tool: str, data: dict[str, Any]) -> list[str]:
    """The changes a tool call would make, as diff lines. Empty if it makes none.

    Only tools that write are described here. Everything else is adequately
    summarized by its one-line summary, and a diff of a Bash command or a Read
    would be noise.
    """
    path = str(data.get("file_path") or data.get("notebook_path") or "")

    if tool == "Edit":
        lines = diff_lines(
            str(data.get("old_string", "")), str(data.get("new_string", "")), hunks=False
        )
        if data.get("replace_all"):
            lines.insert(0, "(replacing every occurrence)")
        return lines

    if tool == "Write":
        before = read_file(path) if path else None
        if before is None:
            return ["(new file)"] + ["+" + line for line in str(data.get("content", "")).splitlines()]
        return diff_lines(before, str(data.get("content", "")), hunks=True)

    if tool == "NotebookEdit":
        mode = str(data.get("edit_mode") or "replace")
        source = str(data.get("new_source", ""))
        cell = str(data.get("cell_id", "?"))
        if mode == "delete":
            return ["(deleting cell %s)" % cell]
        head = "(%s cell %s)" % ("inserting" if mode == "insert" else "replacing", cell)
        return [head] + ["+" + line for line in source.splitlines()]

    return []


def show_preview(tool: str, data: dict[str, Any]) -> None:
    """Print what a tool call would change, capped so the prompt stays visible."""
    lines = preview(tool, data)
    if not lines:
        return
    for line in lines[:PREVIEW_LINES]:
        meta("  %s" % line if line else "")
    extra = len(lines) - PREVIEW_LINES
    if extra > 0:
        meta("  ... %d more line%s; v shows the whole input" % (extra, "" if extra == 1 else "s"))


def decision(
    kind: str, reason: str, updated_input: dict[str, Any] | None = None
) -> dict[str, Any]:
    """A PreToolUse hook result allowing or denying one call.

    `updated_input` replaces the input the model asked for; see foreground_input.
    """
    output: dict[str, Any] = {
        "hookEventName": "PreToolUse",
        "permissionDecision": kind,
        "permissionDecisionReason": reason,
    }
    if updated_input is not None:
        output["updatedInput"] = updated_input
    return {"hookSpecificOutput": output}


def foreground_input(tool: str, data: dict[str, Any]) -> dict[str, Any] | None:
    """The same agent call run in the foreground, or None to leave it alone.

    A backgrounded agent hands the prompt back while it is still working, and
    everything it goes on to say arrives in a later turn. That is worth it only
    if there is a second conversation to get on with, and here there is not:
    one terminal, one prompt, one thread reading it. So the call is rewritten
    to run in the foreground, where its result comes back inside the turn that
    asked for it.

    Only agent tools. `Bash(run_in_background=True)` is a dev server or a
    `tail -f`, which is meant to outlive the call and would hang the turn
    forever if it were forced to finish first.

    The tool defaults to running in the background when the field is absent, so
    anything that is not already an explicit false gets rewritten.
    """
    if not FORCE_FOREGROUND or tool not in AGENT_TOOLS:
        return None
    if data.get("run_in_background") is False:
        return None
    return dict(data, run_in_background=False)


async def pre_tool_use(
    input_data: dict[str, Any],
    tool_use_id: str | None,
    context: Any,
) -> dict[str, Any]:
    """Ask the user about every tool call before it runs."""
    tool = input_data.get("tool_name", "?")
    data = input_data.get("tool_input") or {}

    # Done before anything else, so the announcement, the approval prompt, and
    # the session allow list all describe the call that will actually run.
    updated = foreground_input(tool, data)
    if updated is not None:
        data = updated
        async with screen_lock:
            meta("[%s: kept in the foreground]" % tool)

    async with screen_lock:
        if tool in session_allowed_tools or signature(tool, data) in session_allowed_calls:
            meta("[%s: %s]" % (tool, summarize(tool, data)))
            return decision("allow", "Allowed for this session by the user.", updated)

    # The reader thread does the asking, because it is the only thread allowed
    # to read stdin. The screen lock must not be held while waiting for the
    # answer, or the reader could never take it to print the question.
    approval = Approval(tool, data, asyncio.get_running_loop().create_future())
    approval.updated_input = updated
    if queue_approval(approval):
        async with screen_lock:
            meta("")
            meta("[%s needs approval -- press Enter to answer]" % tool)
    return await approval.future


def approval_answer(approval: Approval) -> dict[str, Any]:
    """Show one tool call and read the user's decision. Reader thread only."""
    tool = approval.tool
    data = approval.data
    meta("")
    meta("Tool request: %s" % tool)
    meta("  %s" % summarize(tool, data))
    show_preview(tool, data)
    # `a` is the narrow answer and `t` the broad one, because the narrow one is
    # what is almost always wanted and so gets the obvious key.
    question = (
        "allow? [y] once  [a] always this exact call  "
        "[t] always any %s  [n] no  [v] view input: " % tool
    )
    ends = 0
    while True:
        answer = ask(question)
        if answer is None:
            meta("")
            ends += 1
            # Ctrl-D is how a message is sent, so it arrives here by accident
            # whenever a background tool interrupts one. Taking the first one as
            # a denial turned a stray keystroke into a rejection, which the
            # model would answer by asking for the same tool again.
            if sys.stdin.isatty() and ends < 3:
                meta("Ctrl-D is not an answer. Answer y, a, t, n, or v; n denies the call.")
                continue
            return decision("deny", "The user ended input without approving.")
        answer = answer.strip().lower()
        if answer in ("y", "yes"):
            return decision("allow", "Approved by the user.", approval.updated_input)
        if answer in ("a", "always"):
            session_allowed_calls.add(signature(tool, data))
            return decision(
                "allow", "Approved by the user for this session.", approval.updated_input
            )
        if answer in ("t", "tool"):
            session_allowed_tools.add(tool)
            meta("Every %s call runs unprompted for the rest of this session." % tool)
            return decision(
                "allow", "Approved by the user for this session.", approval.updated_input
            )
        if answer in ("n", "no"):
            reason = ask("reason (optional): ")
            reason = (reason or "").strip()
            return decision("deny", reason or "The user denied this tool call.")
        if answer in ("v", "view"):
            meta(json.dumps(data, indent=2))
        else:
            meta("Answer y, a, t, n, or v.")


def serve_approval(
    loop: asyncio.AbstractEventLoop, approval: Approval, held: int
) -> None:
    """Ask about one tool call, owning the terminal until it is answered."""
    hold_screen(loop)
    try:
        answer = approval_answer(approval)
    finally:
        release_screen(loop)
    loop.call_soon_threadsafe(resolve_approval, approval, answer)
    if held:
        meta("(back to your message, %d line%s so far)" % (held, "" if held == 1 else "s"))


def input_loop(loop: asyncio.AbstractEventLoop, prompts: asyncio.Queue) -> None:
    """Read every line the session needs and decide what each one is for.

    The only place in the program that calls input(). It alternates between the
    message being composed and approval prompts for tool calls, which a
    background tool can raise at any moment. An approval is always served
    first, and the message being composed survives the interruption untouched.
    """
    global composer_reading
    lines: list[str] = []
    while True:
        work = next_input_work()
        if work == "stop":
            return
        if isinstance(work, Approval):
            serve_approval(loop, work, len(lines))
            continue

        tty = sys.stdout.isatty()
        with input_cv:
            composer_reading = True
        try:
            line = read_line("> " if (tty and not lines) else "")
        finally:
            with input_cv:
                composer_reading = False

        if line is None:
            meta("")
            # Ctrl-D. A waiting approval comes first: the model is blocked on it
            # and a new message cannot be sent while a tool is mid-flight. The
            # typed text is kept, so the send is one more Ctrl-D away.
            if pending_approvals:
                continue
            if lines:
                deliver_prompt(loop, prompts, join_lines(lines))
                lines = []
                continue
            if not sys.stdin.isatty():
                deliver_prompt(loop, prompts, None)
                return
            meta("Nothing to send. Type /quit on its own line to exit.")
            continue

        command = line.strip().lower()
        # A typed alternative to Ctrl-D, which also makes the client scriptable:
        # piped input has no way to send an EOF mid-stream.
        if command == "/send":
            if pending_approvals:
                meta("Answer the tool approval first. Your message is kept.")
                continue
            deliver_prompt(loop, prompts, join_lines(lines))
            lines = []
            continue
        if command in QUIT_COMMANDS:
            # Never discard typed text on a stray /quit.
            if lines:
                meta("Unsent text above. Send it, or /discard it, then /quit.")
                continue
            deliver_prompt(loop, prompts, None)
            return
        if command == "/discard":
            lines.clear()
            meta("(discarded)")
            continue
        # A bare Enter typed only to reach a waiting approval prompt is not part
        # of the message.
        if pending_approvals and not lines and not line.strip():
            continue
        lines.append(line)


def result_text(content: str | list[dict[str, Any]] | None) -> str:
    """Flatten a tool result into text."""
    if content is None:
        return ""
    if isinstance(content, str):
        return content
    parts = []
    for block in content:
        parts.append(block.get("text", "") if block.get("type") == "text" else json.dumps(block))
    return "\n".join(parts)


def end_segment() -> None:
    """Separate one finished response from whatever is printed next."""
    global last_char
    sys.stdout.write("\n" if last_char == "\n" else "\n\n")
    sys.stdout.flush()
    last_char = "\n"


async def run_turn(client: ClaudeSDKClient, prompt: str) -> str | None:
    """Send one prompt and print the response. Returns the session id.

    A turn is over when a result arrives and no background agent is still
    running, which is not the same as the first result: an agent started in the
    background outlives the turn that started it, and its completion wakes the
    model for a follow-up turn on this same connection. Returning at the first
    result would put the message prompt up over the top of that, and nothing
    the agents went on to produce would be read off the connection until the
    user sent an unrelated message, which then got answered together with the
    agent output. So the stream is read past the result, and the prompt does
    not come back until the work behind it is actually finished.
    """
    global turn_had_text
    turn_had_text = False
    session_id = None
    # Background agents still running. Local to the turn: a stale id that never
    # gets a terminal frame is dropped here rather than parking every turn
    # after it. Names are kept separately and never removed, because the id has
    # to stay readable in the message announcing that it finished.
    inflight: set[str] = set()
    agent_names: dict[str, str] = {}

    await client.query(prompt)
    meta("Waiting for response...")
    finished = False
    async for message in client.receive_messages():
        # Wait out any approval prompt rather than printing over it.
        async with screen_lock:
            # The task lifecycle messages subclass SystemMessage, so they have
            # to be matched before it.
            if isinstance(message, TaskStartedMessage):
                if message.task_type in DEFERRED_TASK_TYPES:
                    name = message.description or message.task_id
                    agent_names[message.task_id] = name
                    inflight.add(message.task_id)
                    meta("[agent started: %s]" % name)
            # An agent's terminal state arrives as a notification, as a
            # task_updated patch, or as both in either order, so either one
            # ends it and whichever lands first is the one that announces it.
            elif isinstance(message, TaskNotificationMessage):
                if message.task_id in inflight:
                    inflight.discard(message.task_id)
                    meta("[agent %s: %s]"
                         % (message.status, agent_names[message.task_id]))
            elif isinstance(message, TaskUpdatedMessage):
                if message.status in TERMINAL_TASK_STATUSES and message.task_id in inflight:
                    inflight.discard(message.task_id)
                    meta("[agent %s: %s]"
                         % (message.status, agent_names[message.task_id]))
            elif isinstance(message, AssistantMessage):
                for block in message.content:
                    if isinstance(block, TextBlock):
                        emit_block(block.text)
                    elif isinstance(block, ThinkingBlock) and SHOW_THINKING:
                        emit_block(block.thinking)
            elif isinstance(message, UserMessage):
                if isinstance(message.content, list):
                    for block in message.content:
                        if isinstance(block, ToolResultBlock):
                            label = "tool error" if block.is_error else "tool result"
                            meta("[%s]" % label)
                            meta(result_text(block.content))
            elif isinstance(message, SystemMessage):
                session_id = message.data.get("session_id") or session_id
            elif isinstance(message, ResultMessage):
                session_id = message.session_id or session_id
                if not turn_had_text and message.result:
                    emit(message.result)
                if message.is_error:
                    meta("[error: %s]" % (message.result or message.subtype))
                end_segment()
                # Each follow-up turn gets its own fallback to the result text.
                turn_had_text = False
                if inflight:
                    meta(
                        "[waiting for %d agent%s to finish: %s]"
                        % (
                            len(inflight),
                            "" if len(inflight) == 1 else "s",
                            "; ".join(agent_names[task] for task in sorted(inflight)),
                        )
                    )
                else:
                    finished = True
        if finished:
            break

    return session_id


async def main(resume: str | None) -> int:
    """Connect, then trade prompts for turns until the user quits."""
    options = ClaudeAgentOptions(
        cwd=os.getcwd(),
        model=os.environ.get("GOOD_CLAUDE_MODEL") or None,
        resume=resume,
        permission_mode="default",
        setting_sources=["user", "project", "local"],
        # Registering this is what stops the subprocess inheriting the
        # terminal; see cli_stderr.
        stderr=cli_stderr,
        hooks={
            "PreToolUse": [
                HookMatcher(
                    matcher=None,
                    hooks=[pre_tool_use],
                    timeout=APPROVAL_TIMEOUT_SECONDS,
                )
            ]
        },
    )

    prompts: asyncio.Queue[str | None] = asyncio.Queue()
    client = ClaudeSDKClient(options=options)
    await client.connect()
    # Daemon, because it can be blocked in input() when the process ends and a
    # reader waiting on a human must not hold up the exit.
    reader = threading.Thread(
        target=input_loop,
        args=(asyncio.get_running_loop(), prompts),
        name="stdin-reader",
        daemon=True,
    )
    reader.start()
    meta("good-claude: connected in %s" % os.getcwd())
    meta("good-claude: Enter starts a new line; Ctrl-D on an empty line sends.")
    meta("good-claude: /send also sends, /discard drops what you have typed.")
    meta("good-claude: /quit to exit, Ctrl-C to interrupt a turn.")
    meta("")

    session_id = None
    try:
        while True:
            request_prompt()
            try:
                prompt = await prompts.get()
            except KeyboardInterrupt:
                # The reader still holds whatever was typed; wait for it again
                # rather than starting a second reader on the same terminal.
                meta("")
                continue
            if prompt is None:
                break
            if not prompt.strip():
                continue

            try:
                new_id = await run_turn(client, prompt)
                if new_id and not session_id:
                    log_session(new_id)
                session_id = new_id or session_id
            except KeyboardInterrupt:
                await client.interrupt()
                meta("")
                meta("(interrupted)")
    finally:
        stop_reader()
        abandon_approvals()
        await client.disconnect()
        if session_id:
            meta("good-claude: resume this conversation with: good-claude --resume %s" % session_id)
    return 0


if __name__ == "__main__":
    parser = argparse.ArgumentParser(prog="good-claude")
    parser.add_argument(
        "-r",
        "--resume",
        metavar="SESSION_ID",
        help="resume an earlier session; ids are logged to %s" % HISTORY_PATH,
    )
    try:
        sys.exit(asyncio.run(main(parser.parse_args().resume)))
    except KeyboardInterrupt:
        sys.exit(130)
